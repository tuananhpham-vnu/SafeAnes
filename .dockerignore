!deploy/frontend/vite.config.ts
!deploy/frontend/src/
!deploy/backend/requirements.txt
!deploy/backend/fetch_bundle.py
!deploy/backend/app/
!src/uc04/__init__.py
!src/uc04/tabm.py
**/__pycache__
